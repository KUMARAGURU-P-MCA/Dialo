# ─────────────────────────────────────────────────────────────────────────────
# PTT Voice Agent — Environment Variables
# Steps:
#   1. Copy this file:  cp env.example .env
#   2. Fill in your real values below
#   3. Never commit the real .env to git — add it to .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get both from: Supabase Dashboard → Project Settings → API

# Your project URL (looks like this):
SUPABASE_URL=https://abcdefghijklmnop.supabase.co

# service_role key — the SECRET key (not the anon/public key).
# This bypasses Row Level Security so the backend can read/write freely.
# NEVER send this key to Flutter or expose it in any client.
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key_here